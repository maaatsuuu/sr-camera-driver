# Host PC IP address used by the Livox SDK config.
LIVOX_HOST_IP=192.168.1.5

# MID360 LiDAR IP address.
LIVOX_MID360_IP=192.168.1.12

# MID360s LiDAR IP addresses.
LIVOX_MID360S_IP=192.168.1.12

# ROS frame_id used in the Livox point cloud header.
LIVOX_FRAME_ID_NAME=mid360_frame

# ROS point cloud topic name after launch remapping.
LIVOX_POINTCLOUD_TOPIC_NAME=sensor/lidar/livox/front/pointcloud

# ROS IMU topic name after launch remapping.
LIVOX_IMU_TOPIC_NAME=sensor/lidar/livox/front/imu
